{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@pages/*": ["./tests/support/pages/*"],
      "@components/*": ["./tests/support/pages/components/*"],
      "@constants/*": ["./tests/support/constants/*"],
      "@helpers/*": ["./tests/support/helpers/*"],
      "@config/*": ["./tests/support/config/*"],
      "@support/*": ["./tests/support/*"]
    }
  },
  "include": ["./tests/**/*.ts", "playwright.config.ts"]
}
